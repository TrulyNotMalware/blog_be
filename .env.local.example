# Template for `.env.local` (gitignored). Highest-priority overrides for
# whatever ENV you start the app with — e.g. real DB credentials, the RSA
# private key, or the admin password hash while developing locally.
#
# Usage:
#   cp .env.local.example .env.local
#   # then edit the values below
#
# Only set the keys you actually want to override; unset keys fall back to
# `.env.{env}` → `.env` → in-code defaults.

DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog

# RS256 private key. Generate locally:
#   openssl genrsa 2048
# then paste the PEM as a single quoted line with literal `\n` between rows,
# e.g. JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
# The matching public key is published at /.well-known/jwks.json for the
# gateway to verify signatures.
JWT_PRIVATE_KEY_PEM=
JWT_KID=v1
ADMIN_PASSWORD_HASH=
