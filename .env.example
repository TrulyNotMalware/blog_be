ENV=local
DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080
WORKERS=1

DATABASE_URL=postgresql+asyncpg://blog:blog@localhost:5432/blog
# Optional — defaults shown. See k8s/configmap.yaml for the connection budget.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=1
# DB_STATEMENT_TIMEOUT_MS=15000
# DB_LOCK_TIMEOUT_MS=5000
# DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# GRACEFUL_SHUTDOWN_SECONDS=20

CORS_ORIGINS=http://localhost:3000

# RS256 (asymmetric). Generate a key pair locally:
#   openssl genrsa -out priv.pem 2048
# then paste the full content of priv.pem (BEGIN / END lines included) below.
# Verifiers (gateway, etc.) fetch the public key from /.well-known/jwks.json.
JWT_PRIVATE_KEY_PEM=
JWT_KID=v1
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_MINUTES=10080
JWT_ISSUER=blog-be

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Hop-proof secret shared with the gateway (`APP_CONFIG_SECURITY_GATEWAY_SHARED_SECRET`).
# Must be set to a strong random value in prod (>=32 chars, e.g. `openssl rand -hex 32`).
# Empty disables the hop check — fine for local dev only.
GATEWAY_SHARED_SECRET=
