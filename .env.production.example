# Backend production environment template.
# Copy to `.env.production` and fill in real values. Never commit secrets.

# --- Database ---
# Cloud Postgres. Production schema only. NEVER point this at blog_test.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/blog

# --- JWT ---
# Generate with: openssl rand -hex 32
# Rotating this value invalidates ALL existing tokens (access + refresh).
JWT_SECRET=

# Access token lifetime — short. Browser auto-rotates via the refresh token.
JWT_ACCESS_EXPIRE_MINUTES=15
# Refresh token lifetime — long. Rotated on every /v1/auth/refresh call.
JWT_REFRESH_EXPIRE_MINUTES=10080

# --- Admin seed (loaded into `admins` table on startup if missing) ---
# Generate bcrypt hash via the seed script (scripts/hash_password.py) or any bcrypt tool.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# --- CORS ---
# Comma-separated list of allowed origins. Must include the deployed FE origin.
CORS_ORIGINS=https://your-domain.com

# --- Runtime ---
ENV=production
